--[[
	1Mag - Unlock All (Skins / Wraps / Charms / Finishers)
	No GUI. Standalone - does not load or depend on any other script.

	Run once. Then open the in-game Equipment screen and pick anything:
	every skin, wrap, charm and finisher shows as owned, and your picks are
	applied locally (the game server is never asked to equip them).
]]

local G = (getgenv and getgenv()) or _G
if G.__1MAG_UNLOCKALL then return end
G.__1MAG_UNLOCKALL = true

task.spawn(function()
-- Auto-execute safe: let the game finish loading and build its own UI first
if not game:IsLoaded() then game.Loaded:Wait() end
local lp0 = game:GetService("Players").LocalPlayer
while not lp0 do task.wait() lp0 = game:GetService("Players").LocalPlayer end
lp0:WaitForChild("PlayerGui")
lp0:WaitForChild("PlayerScripts")
task.wait(4)

local Players        = game:GetService("Players")
local RS             = game:GetService("ReplicatedStorage")
local lp             = Players.LocalPlayer
------------------------------------------------------------------------
-- Load the game's modules
------------------------------------------------------------------------
-- Only require a game module after the game itself has loaded it, so we never
-- trigger its init early (that is what made the lobby UI pop up all at once).
local function isLoaded(mod)
	if type(getloadedmodules) ~= "function" then return true end
	local ok, list = pcall(getloadedmodules)
	if not ok or type(list) ~= "table" then return true end
	return table.find(list, mod) ~= nil
end

local function safeRequire(mod, timeout)
	if typeof(mod) ~= "Instance" then return nil end
	local t0 = os.clock()
	while not isLoaded(mod) do
		if os.clock() - t0 > (timeout or 40) then return nil end
		task.wait(0.5)
	end
	local ok, r = pcall(require, mod)
	return ok and r or nil
end

local function findPath(root, path)
	local cur = root
	for part in path:gmatch("[^%.]+") do
		cur = cur and cur:FindFirstChild(part)
	end
	return cur
end
local Cosmetics, cosLib, datCtrl, enumLib

local okInit, initErr = pcall(function()
	local ctrl = lp:WaitForChild("PlayerScripts"):WaitForChild("Controllers", 30)
	local mods = RS:WaitForChild("Modules", 30)
	enumLib = safeRequire(mods:WaitForChild("EnumLibrary", 30))
	if enumLib then pcall(function() enumLib:WaitForEnumBuilder() end) end
	cosLib  = safeRequire(mods:WaitForChild("CosmeticLibrary", 30))
	datCtrl = safeRequire(ctrl:WaitForChild("PlayerDataController", 30))
	Cosmetics = cosLib.Cosmetics
end)

if not okInit or type(Cosmetics) ~= "table" or not datCtrl then
	G.__1MAG_UNLOCKALL = nil
	warn("[1Mag] Unlock All: could not load game modules: " .. tostring(initErr))
	return
end

------------------------------------------------------------------------
-- Helpers
------------------------------------------------------------------------
local function norm(w)
	if type(w) == "table" then w = w.Name end
	if type(w) ~= "string" then return nil end
	return (w:lower():gsub("%s+", ""))
end

local function allowed(name)
	if type(name) ~= "string" then return false end
	local c = Cosmetics[name]
	if type(c) ~= "table" then return false end
	return name:match("^MISSING_") == nil
end

local itemNames
local function itemMap()
	if itemNames then return itemNames end
	itemNames = {}
	local il = RS.Modules:FindFirstChild("ItemLibrary")
	if il then
		local ok, lib = pcall(require, il)
		if ok and type(lib) == "table" and type(lib.Items) == "table" then
			for n in pairs(lib.Items) do
				if type(n) == "string" then itemNames[n] = true end
			end
		end
	end
	return itemNames
end

local function mkSkin(name, seed)
	local base = Cosmetics[name]
	if not base then return nil end
	local d = {}
	for k, v in pairs(base) do d[k] = v end
	d.Name = name
	d.Type = d.Type or "Skin"
	d.Seed = seed or d.Seed or math.random(1, 1000000)
	if enumLib then
		local ok, id = pcall(enumLib.ToEnum, enumLib, name)
		if ok and id then
			d.Enum = id
			d.ObjectID = d.ObjectID or id
		end
	end
	return d
end

local function runId2(cb)
	local prev = type(getthreadidentity) == "function" and getthreadidentity() or nil
	if type(setthreadidentity) == "function" then pcall(setthreadidentity, 2) end
	local ok, a, b = pcall(cb)
	if prev ~= nil and type(setthreadidentity) == "function" then pcall(setthreadidentity, prev) end
	return ok, a, b
end

local function encodeKey(key)
	local toEnum = type(enumLib) == "table" and rawget(enumLib, "_to_enum") or nil
	local v = type(toEnum) == "table" and rawget(toEnum, key) or nil
	return v ~= nil and v or key
end

------------------------------------------------------------------------
-- State
------------------------------------------------------------------------
local equipped = {}   -- [normalized weapon] = { weapon, skin, wrap, charm, finisher, inverted }
local origData = {}   -- [normalized weapon] = untouched viewmodel data
local active   = true
local remote   = {}   -- [userId] = { [normalized weapon] = { skin, wrap, charm, finisher, inverted } }  (other script users)

local function entry(weapon, create)
	local k = norm(weapon)
	if not k then return nil end
	local e = equipped[k]
	if not e and create then
		e = { weapon = weapon }
		equipped[k] = e
	end
	return e
end

local function applySel(data, e, key)
	if not (data and e) then return end
	if e.skin then
		data[key("Skin")] = e.skin.data
		data[key("Name")] = e.skin.name
	end
	if e.wrap   then data[key("Wrap")]  = { Name = e.wrap, Inverted = e.inverted and true or nil } end
	if e.charm  then data[key("Charm")] = { Name = e.charm } end
end

local function remoteEntry(owner, weapon)
	if typeof(owner) ~= "Instance" or owner == lp then return nil end
	local r = remote[owner.UserId]
	local k = norm(weapon)
	return r and k and r[k] or nil
end

------------------------------------------------------------------------
-- Save / load picks (survives rejoining)
------------------------------------------------------------------------
local HttpService = game:GetService("HttpService")
local SAVE_DIR  = "1MagHub"
local SAVE_FILE = SAVE_DIR .. "/unlockall_saved.json"
local canFS = type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"

local function saveNow()
	if not canFS then return end
	local out = {}
	for _, e in pairs(equipped) do
		local w = type(e.weapon) == "table" and e.weapon.Name or e.weapon
		if type(w) == "string" then
			out[w] = {
				skin = (not (e.rand and e.rand.Skin) and e.skin) and e.skin.name or nil,
				wrap = not (e.rand and e.rand.Wrap) and e.wrap or nil,
				charm = not (e.rand and e.rand.Charm) and e.charm or nil,
				finisher = not (e.rand and e.rand.Finisher) and e.finisher or nil,
				inverted = e.inverted, rand = e.rand,
			}
		end
	end
	pcall(function()
		if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(SAVE_DIR) then
			makefolder(SAVE_DIR)
		end
		writefile(SAVE_FILE, HttpService:JSONEncode(out))
	end)
end

local saveQueued = false
local function saveSoon()
	if saveQueued then return end
	saveQueued = true
	task.delay(1, function()
		saveQueued = false
		saveNow()
	end)
end

------------------------------------------------------------------------
-- Viewmodel reload (so a pick shows up immediately on the held weapon)
------------------------------------------------------------------------
local fighterCtrl
local function localFighter()
	if not fighterCtrl then
		pcall(function() fighterCtrl = require(lp.PlayerScripts.Controllers.FighterController) end)
	end
	if not fighterCtrl then return nil end
	local f = fighterCtrl.LocalFighter
	if not f and type(fighterCtrl.GetFighter) == "function" then
		local ok, r = pcall(fighterCtrl.GetFighter, fighterCtrl, lp)
		f = ok and r or nil
	end
	return f
end

local function findItem(weapon)
	local f = localFighter()
	if type(f) ~= "table" then return nil, nil end
	local held = rawget(f, "EquippedItem")
	if type(held) == "table" and norm(rawget(held, "Name")) == norm(weapon) then return held, f end
	for _, field in ipairs({ "Loadout", "Slots", "Items", "EquippedItems" }) do
		local items = rawget(f, field)
		if type(items) == "table" then
			for _, it in pairs(items) do
				if type(it) == "table" and norm(rawget(it, "Name")) == norm(weapon) then return it, f end
			end
		end
	end
	return nil, f
end

local reloading = {}
local function reloadWeapon(weapon)
	local k = norm(weapon)
	if not k or reloading[k] then return false end
	local item, fighter = findItem(weapon)
	local vm = item and rawget(item, "ViewModel")
	if type(vm) ~= "table" then return false end
	local vmData = rawget(vm, "Data")
	if type(vmData) ~= "table" and not origData[k] then return false end

	reloading[k] = true
	local done = false
	pcall(function()
		local base = origData[k] and table.clone(origData[k]) or table.clone(vmData)
		origData[k] = origData[k] or table.clone(base)
		applySel(base, active and entry(weapon) or nil, encodeKey)

		local cvmClass
		pcall(function()
			cvmClass = require(lp.PlayerScripts.Modules.ClientReplicatedClasses.ClientFighter.ClientItem.ClientViewModel)
		end)
		if type(cvmClass) ~= "table" or type(cvmClass.Destroy) ~= "function" then return end
		local create = item._CreateViewModel
		if type(create) ~= "function" then return end

		local info = { [encodeKey("Data")] = base }
		local armsData
		if type(fighter) == "table" and type(fighter.GetArmsData) == "function" then
			armsData = table.pack(fighter:GetArmsData())
		end

		runId2(function() cvmClass.Destroy(vm) end)
		local ok, newVm = runId2(function() return create(item, info) end)
		if not ok or type(newVm) ~= "table" then return end
		rawset(item, "ViewModel", newVm)

		runId2(function()
			if armsData and type(newVm.SetArmsData) == "function" then
				newVm:SetArmsData(unpack(armsData, 1, armsData.n))
			end
			if type(newVm.Equip) == "function" then newVm:Equip(true) end
		end)
		local spring = rawget(newVm, "_equip_spring")
		if type(spring) == "table" then
			rawset(spring, "_position0", 0)
			rawset(spring, "_velocity0", 0)
		end
		done = true
	end)
	reloading[k] = nil
	return done
end

local function retryReload(weapon)
	task.spawn(function()
		for _ = 1, 15 do
			task.wait(2)
			if not active then return end
			local ok, res = pcall(reloadWeapon, weapon)
			if ok and res then return end
		end
	end)
end

local pendingRefresh, refreshQueued = {}, false
local function refresh(weapon)
	saveSoon()
	if weapon then pendingRefresh[weapon] = true end
	if refreshQueued then return end
	refreshQueued = true
	task.defer(function()
		refreshQueued = false
		local list = pendingRefresh
		pendingRefresh = {}
		pcall(function() datCtrl.CurrentData:Replicate("WeaponInventory") end)
		for w in pairs(list) do
			local ok, res = pcall(reloadWeapon, w)
			if ok and res == false then retryReload(w) end
		end
	end)
end

local function setCosmetic(weapon, kind, name, inverted)
	local e = entry(weapon, true)
	if not e then return false end
	if name ~= nil and not allowed(name) then return false end
	if inverted ~= nil then e.inverted = inverted and true or false end
	if e.rand then e.rand[kind] = nil end
	if kind == "Skin" then
		e.skin = name and { name = name, data = mkSkin(name) } or nil
	elseif kind == "Wrap" then
		e.wrap = name
	elseif kind == "Charm" then
		e.charm = name
	elseif kind == "Finisher" then
		e.finisher = name
	else
		return false
	end
	refresh(weapon)
	return true
end

-- Random: pools + roll
local function folderNames(folder)
	if not folder then return nil end
	local t = {}
	for _, c in ipairs(folder:GetChildren()) do t[c.Name] = true end
	return t
end

local poolCache = {}
local function pool(weapon, kind)
	local wname = type(weapon) == "table" and weapon.Name or weapon
	if type(wname) ~= "string" then return {} end
	local ck = kind == "Skin" and (kind .. "|" .. wname) or kind
	if poolCache[ck] then return poolCache[ck] end
	local avail
	if kind == "Charm" then
		local a = lp:FindFirstChild("PlayerScripts") and lp.PlayerScripts:FindFirstChild("Assets")
		avail = folderNames(a and a:FindFirstChild("Charms"))
	elseif kind == "Finisher" then
		local m = RS:FindFirstChild("Modules")
		avail = folderNames(m and m:FindFirstChild("Finishers"))
	end
	local out = {}
	for name, c in pairs(Cosmetics) do
		if type(c) == "table" and c.Type == kind and allowed(name)
			and (kind ~= "Skin" or c.ItemName == wname)
			and (avail == nil or avail[name]) then
			out[#out + 1] = name
		end
	end
	table.sort(out)
	poolCache[ck] = out
	return out
end

local function roll(e, kind)
	local list = pool(e.weapon, kind)
	if #list == 0 then return false end
	local pick = list[math.random(#list)]
	if kind == "Skin" then
		e.skin = { name = pick, data = mkSkin(pick) }
	elseif kind == "Wrap" then
		e.wrap = pick
	elseif kind == "Charm" then
		e.charm = pick
	elseif kind == "Finisher" then
		e.finisher = pick
	else
		return false
	end
	return true
end

local function setRandom(weapon, kind)
	local e = entry(weapon, true)
	if not e then return false end
	-- Only mark the slot as Random. Nothing changes in the menu; a new cosmetic is
	-- rolled whenever the weapon model is built (every spawn / loadout re-pick).
	e.rand = e.rand or {}
	e.rand[kind] = true
	if kind == "Skin" then e.skin = nil
	elseif kind == "Wrap" then e.wrap = nil
	elseif kind == "Charm" then e.charm = nil
	elseif kind == "Finisher" then e.finisher = nil end
	saveSoon()
	return true
end

local function getCosmetic(weapon, kind)
	local e = entry(weapon)
	if not e then return nil end
	if kind == "Skin" then return e.skin and e.skin.name end
	if kind == "Wrap" then return e.wrap end
	if kind == "Charm" then return e.charm end
	if kind == "Finisher" then return e.finisher end
end

------------------------------------------------------------------------
-- Ownership hooks: everything counts as owned
------------------------------------------------------------------------
for _, key in ipairs({ "OwnsCosmetic", "OwnsCosmeticNormally", "OwnsCosmeticUniversally", "OwnsCosmeticForWeapon" }) do
	local orig = cosLib[key]
	if type(orig) == "function" then
		cosLib[key] = function(self, inv, nm, ...)
			if active and (allowed(nm) or nm == "RANDOM_COSMETIC" or nm == "NONE_COSMETIC") then return true end
			return orig(self, inv, nm, ...)
		end
	end
end

local origGet = datCtrl.Get
local invSrc, invProxy
local invMeta = {
	__index = function(_, k)
		if k == "RANDOM_COSMETIC" or k == "NONE_COSMETIC" then return true end
		if not allowed(k) then return nil end
		local t = Cosmetics[k].Type
		if t == "Wrap" or t == "Charm" or t == "Finisher" then return itemMap() end
		return true
	end,
}
datCtrl.Get = function(self, key, ...)
	local val = origGet(self, key, ...)
	if active and key == "CosmeticInventory" then
		if invProxy and invSrc == val then return invProxy end
		local prx = {}
		if type(val) == "table" then for k, v in pairs(val) do prx[k] = v end end
		invSrc, invProxy = val, setmetatable(prx, invMeta)
		return invProxy
	end
	return val
end

local origGetWep = datCtrl.GetWeaponData
local wepCache = {}
datCtrl.GetWeaponData = function(self, wn, ...)
	local d = origGetWep(self, wn, ...)
	if not d then return nil end
	local e = active and entry(wn)
	if e and (e.skin or e.wrap or e.charm or e.finisher) then
		local sig = table.concat({
			e.skin and e.skin.name or "", e.wrap or "", tostring(e.inverted),
			e.charm or "", e.finisher or "" }, "|")
		local c = wepCache[wn]
		if c and c.src == d and c.sig == sig then return c.out end
		local m = {}
		for k, v in pairs(d) do m[k] = v end
		m.Name = wn
		if e.skin     then m.Skin     = e.skin.data end
		if e.wrap     then m.Wrap     = { Name = e.wrap, Inverted = e.inverted and true or nil } end
		if e.charm    then m.Charm    = { Name = e.charm } end
		if e.finisher then m.Finisher = { Name = e.finisher } end
		wepCache[wn] = { src = d, sig = sig, out = m }
		return m
	end
	return d
end

------------------------------------------------------------------------
-- Viewmodel hooks (apply picks when a weapon model is built)
------------------------------------------------------------------------
local buildingWep
local cliItem
pcall(function()
	cliItem = safeRequire(findPath(lp.PlayerScripts, "Modules.ClientReplicatedClasses.ClientFighter.ClientItem"))
end)
if cliItem and cliItem._CreateViewModel then
	local origCVM = cliItem._CreateViewModel
	cliItem._CreateViewModel = function(self, vmRef, ...)
		local owner = self.ClientFighter and self.ClientFighter.Player
		buildingWep = owner and self.Name or nil
		if owner and owner ~= lp and active and type(vmRef) == "table" then
			local re = remoteEntry(owner, self.Name)
			if re then
				local dk = self:ToEnum("Data")
				if type(vmRef[dk]) == "table" then
					applySel(vmRef[dk], re, function(n) return self:ToEnum(n) end)
				elseif type(vmRef.Data) == "table" then
					applySel(vmRef.Data, re, function(n) return n end)
				end
			end
		end
		if owner == lp and type(vmRef) == "table" then
			local k = norm(self.Name)
			local dk = self:ToEnum("Data")
			local data = vmRef[dk] or vmRef.Data
			if type(data) == "table" and k and not origData[k] then origData[k] = table.clone(data) end
			local e = active and entry(self.Name)
			if e and e.rand then
				for kind in pairs(e.rand) do roll(e, kind) end
			end
			if e and data then
				if vmRef[dk] then
					applySel(vmRef[dk], e, function(n) return self:ToEnum(n) end)
				else
					applySel(vmRef.Data, e, function(n) return n end)
				end
			end
		end
		local r = origCVM(self, vmRef, ...)
		buildingWep = nil
		return r
	end
end

pcall(function()
	local vmMod = lp.PlayerScripts.Modules.ClientReplicatedClasses.ClientFighter.ClientItem:FindFirstChild("ClientViewModel")
	if not vmMod then return end
	local CVM = safeRequire(vmMod)
	local RC  = safeRequire(RS.Modules.ReplicatedClass)
	if not (CVM and RC) then return end
	local origNew = CVM.new
	CVM.new = function(repData, cliItm, ...)
		local owner = cliItm.ClientFighter and cliItm.ClientFighter.Player
		local wn = buildingWep or cliItm.Name
		local e = active and ((owner == lp and entry(wn)) or remoteEntry(owner, wn))
		if e then
			local dk = RC:ToEnum("Data")
			repData[dk] = repData[dk] or {}
			applySel(repData[dk], e, function(n) return RC:ToEnum(n) end)
		end
		return origNew(repData, cliItm, ...)
	end
end)

-- Finishers
pcall(function()
	local ce = safeRequire(findPath(lp.PlayerScripts, "Modules.ClientReplicatedClasses.ClientEntity"))
	if type(ce) ~= "table" or type(ce._PlayFinisher) ~= "function" then return end
	local origPF = ce._PlayFinisher
	ce._PlayFinisher = function(self, finisherName, ...)
		if active then
			local owner, cf
			pcall(function()
				cf = self.ClientFighter
				owner = self.Player or (cf and cf.Player)
			end)
			if typeof(owner) == "Instance" and owner ~= lp then
				-- another player: use their synced finisher if they run the script
				local held = type(cf) == "table" and rawget(cf, "EquippedItem")
				local re = type(held) == "table" and remoteEntry(owner, rawget(held, "Name"))
				if re and re.finisher then return origPF(self, re.finisher, ...) end
			else
				local f = localFighter()
				local held = f and rawget(f, "EquippedItem")
				local e = type(held) == "table" and entry(rawget(held, "Name"))
				if e and e.finisher then return origPF(self, e.finisher, ...) end
			end
		end
		return origPF(self, finisherName, ...)
	end
end)

------------------------------------------------------------------------
-- Inventory bridge
--  1) stops the Equipment screen from sending equip requests to the server
--     (the server would reject items you don't own)
--  2) watches what you select in the screen and applies it locally
------------------------------------------------------------------------
local invBridge = { token = nil, blocked = nil }

local function getEquipModule()
	-- never initialise the Equipment screen ourselves: only use it once the game has
	local mod = findPath(lp.PlayerScripts, "Modules.UserInterface.Equipment")
	if not mod or not isLoaded(mod) then return nil end
	local ok, eq = pcall(require, mod)
	if ok and type(eq) == "table" then return eq end
	return nil
end

local function blockServerEquip(eq)
	if invBridge.blocked then return end
	local d = debug
	if not (d and d.getprotos and d.getproto and d.getconstants and d.setconstant) then return end
	pcall(function()
		local t = eq
		for _, key in ipairs({ "Interface", "Customize", "Options" }) do t = rawget(t, key) end
		local init = rawget(rawget(getmetatable(t), "__index"), "_Init")
		local list = {}
		for k in pairs(d.getprotos(init)) do
			local pr = d.getproto(init, k, true)
			local f = pr and pr[1]
			if f then
				for ci, c in pairs(d.getconstants(f)) do
					if c == "FireServer" then
						d.setconstant(f, ci, "GetChildren")
						list[#list + 1] = { f = f, i = ci }
						break
					end
				end
			end
		end
		if #list > 0 then invBridge.blocked = list end
	end)
end

local PICKABLE = { Skin = true, Wrap = true, Charm = true, Finisher = true }

local function startInventoryBridge()
	if invBridge.token then return end
	local eq = getEquipModule()
	local state = eq and rawget(eq, "EquipmentState")
	if type(state) ~= "table" then return end

	blockServerEquip(eq)
	local my = {}
	invBridge.token = my

	task.spawn(function()
		local lastW, lastT, lastC, lastI
		while invBridge.token == my and active do
			local w = rawget(state, "SelectedWeapon")
			local t = rawget(state, "CustomizingType")
			local c = rawget(state, "SelectedCosmetic")
			local inv
			pcall(function() inv = state.CosmeticInverted == true end)

			if w ~= nil and w == lastW and t == lastT and PICKABLE[t] then
				local wname = type(w) == "table" and w.Name or w
				if c ~= lastC then
					local name = c
					if name == "NONE_COSMETIC" then name = nil end
					if name == "RANDOM_COSMETIC" then
						setRandom(wname, t)
					elseif getCosmetic(wname, t) ~= name or (entry(wname) and entry(wname).rand and entry(wname).rand[t]) then
						setCosmetic(wname, t, name, (t == "Wrap") and inv or nil)
					end
				elseif t == "Wrap" and inv ~= lastI and lastI ~= nil and getCosmetic(wname, "Wrap") then
					local e = entry(wname, true)
					e.inverted = inv and true or false
					refresh(wname)
				end
			end
			lastW, lastT, lastC, lastI = w, t, c, inv
			task.wait(0.1)
		end
	end)
end

-- Restore what you picked last time
local function loadSaved()
	if not canFS then return end
	local ok, raw = pcall(function()
		if isfile(SAVE_FILE) then return readfile(SAVE_FILE) end
	end)
	if not ok or type(raw) ~= "string" then return end
	local ok2, data = pcall(HttpService.JSONDecode, HttpService, raw)
	if not ok2 or type(data) ~= "table" then return end
	for w, v in pairs(data) do
		if type(w) == "string" and type(v) == "table" then
			local e = entry(w, true)
			if allowed(v.skin)     then e.skin = { name = v.skin, data = mkSkin(v.skin) } end
			if allowed(v.wrap)     then e.wrap = v.wrap end
			if allowed(v.charm)    then e.charm = v.charm end
			if allowed(v.finisher) then e.finisher = v.finisher end
			if type(v.inverted) == "boolean" then e.inverted = v.inverted end
			if type(v.rand) == "table" then
				e.rand = {}
				for k, on in pairs(v.rand) do
					if on == true and PICKABLE[k] then e.rand[k] = true end
				end
			end
			refresh(w)
		end
	end
end
