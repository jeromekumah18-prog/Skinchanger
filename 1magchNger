-- SYNC: script users in the same server see each other's cosmetics
-- Needs the relay (relay.js) running somewhere. Only players who run this
-- script AND know RELAY_KEY are ever sent/received.
------------------------------------------------------------------------
local RELAY_URL = "https://onemag-relay.onrender.com/sync"
local RELAY_KEY = "1magddpxxttiov"
local POLL_SECONDS = 4

local httpReq = (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request)

local function buildLoadout()
	local out = {}
	for _, e in pairs(equipped) do
		local w = type(e.weapon) == "table" and e.weapon.Name or e.weapon
		if type(w) == "string" and (e.skin or e.wrap or e.charm or e.finisher) then
			out[w] = {
				skin = e.skin and e.skin.name or nil,
				seed = e.skin and e.skin.data and e.skin.data.Seed or nil,
				wrap = e.wrap, charm = e.charm, finisher = e.finisher,
				inverted = e.inverted,
			}
		end
	end
	return out
end

local function ingest(players)
	local seen = {}
	for uid, loadout in pairs(players) do
		local id = tonumber(uid)
		if id and id ~= lp.UserId and type(loadout) == "table" then
			local r = {}
			for w, v in pairs(loadout) do
				local k = norm(w)
				if k and type(v) == "table" then
					local e = { weapon = w }
					if type(v.skin) == "string" and allowed(v.skin) then
						e.skin = { name = v.skin, data = mkSkin(v.skin, tonumber(v.seed)) }
					end
					if type(v.wrap) == "string" and allowed(v.wrap) then e.wrap = v.wrap end
					if type(v.charm) == "string" and allowed(v.charm) then e.charm = v.charm end
					if type(v.finisher) == "string" and allowed(v.finisher) then e.finisher = v.finisher end
					if type(v.inverted) == "boolean" then e.inverted = v.inverted end
					r[k] = e
				end
			end
			remote[id] = r
			seen[id] = true
		end
	end
	for id in pairs(remote) do
		if not seen[id] then remote[id] = nil end
	end
end

task.spawn(function()
	if not httpReq then
		warn("[1Mag] Sync disabled: your executor has no HTTP request function")
		return
	end
	if RELAY_URL:find("YOUR%-RELAY") then
		warn("[1Mag] Sync disabled: set RELAY_URL in the script")
		return
	end
	while active do
		local ok, res = pcall(httpReq, {
			Url = RELAY_URL,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode({
				key = RELAY_KEY,
				jobId = game.JobId,
				userId = lp.UserId,
				loadout = buildLoadout(),
			}),
		})
		if ok and type(res) == "table" and res.StatusCode == 200 then
			local ok2, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
			if ok2 and type(data) == "table" and type(data.players) == "table" then
				pcall(ingest, data.players)
			end
		end
		task.wait(POLL_SECONDS)
	end
end)

